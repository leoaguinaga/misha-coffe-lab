---
import Card from "../ui/Card.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { locations } from "../../data/locations.data";
---

<section id="sedes" class="bg-white py-12 scroll-m-12" aria-labelledby="locations-title">
  <div class="mx-auto max-w-6xl px-4 xl:px-0">
    <div class="w-full mb-8 md:mb-0 flex flex-col md:flex-row items-center gap-4">
      <SectionHeading
        eyebrow="Nuestras Sedes"
        title="Encuéntranos en Chiclayo"
        align="center"
        titleTag="h2"
        class="md:mb-8 place-self-center"
      />
      <!-- <div class="flex gap-2 items-center justify-self-start">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-10 p-2 bg-primary/10 rounded-full text-primary"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 19.5 8.25 12l7.5-7.5"></path>
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-10 p-2 bg-primary/10 rounded-full text-primary"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m8.25 4.5 7.5 7.5-7.5 7.5"></path>
        </svg>
      </div> -->
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        locations.map((location) => (
          <Card class="group overflow-hidden hover:border-primary/30 hover:shadow-xl">
            <iframe
              src={`https://www.google.com/maps?q=${location.coordinates}&z=16&output=embed`}
              title={`Mapa de MISHA — ${location.address}`}
              class="h-56 w-full border-0"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <div class="flex flex-col gap-2 p-4">
              <h3 class="font-display text-2xl text-secondary">
                {location.name}
              </h3>
              <p class="leading-relaxed text-secondary/65">
                {location.address}
              </p>
              <a
                href={location.mapUrl}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-primary transition-all hover:gap-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
              >
                Abrir en Google Maps
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </Card>
        ))
      }
    </div>
  </div>
</section>
