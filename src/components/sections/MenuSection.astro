---
import Badge from '../ui/Badge.astro';
import { menuCategories } from '../../data/menu-categories.data';
---

<section class="mx-auto max-w-6xl scroll-mt-40 px-4 py-10 md:py-18 xl:px-0" data-menu-content>
  {menuCategories.map((category, index) => {
    return (
      <section id={category.id} class="menu-category mb-18 scroll-mt-40 md:mb-28" data-category-section={category.id} aria-labelledby={`${category.id}-title`}>
        <div class="mb-6 flex items-end justify-between gap-4 md:mb-9">
          <h2 id={`${category.id}-title`} class="misha-subheading max-w-xl text-secondary">{category.name}</h2>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {category.items.map((item, itemIndex) => (
            <article class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-[0_12px_28px_rgba(41,27,19,0.08)] transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_18px_36px_rgba(41,27,19,0.13)]">
              <div class="relative aspect-[4/3] overflow-hidden bg-secondary">
                <img
                  src={item.image}
                  alt={item.name}
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  loading={index === 0 && itemIndex < 3 ? 'eager' : 'lazy'}
                />
                <div class="absolute inset-0 bg-linear-to-t from-secondary/35 via-transparent to-transparent"></div>
                {item.badge && <Badge class="absolute left-4 top-4 rounded-full bg-primary px-3 py-1 text-[10px] tracking-[0.08em] text-white">{item.badge}</Badge>}
              </div>

              <div class="flex flex-1 flex-col p-5 md:p-6">
                <div class="flex items-start justify-between gap-4">
                  <h3 class="text-xl font-bold leading-tight tracking-[-0.025em] text-secondary transition-colors group-hover:text-primary">{item.name}</h3>
                  <p class="shrink-0 pt-0.5 text-lg font-bold tracking-[-0.03em] text-primary">{item.price}</p>
                </div>
                <p class="mt-3 text-sm leading-relaxed text-secondary/65">{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    );
  })}
