---
import MainLayout from '../layouts/MainLayout.astro';
import MenuHeaderSection from '../components/sections/MenuHeaderSection.astro';
import MenuSection from '../components/sections/MenuSection.astro';

const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Carta', href: '/carta.html' },
  { label: 'Sedes', href: '/#sedes' },
  { label: 'Contacto', href: '/#contacto' }
] as const;
---

<MainLayout
  title="Carta | MISHA"
  description="Explora la carta de MISHA: café peruano, métodos, bebidas y acompañamientos."
  navItems={navItems}
  ctaLabel="Volver al inicio"
  ctaHref="/"
  showFooter={true}
>
  <section class="relative">
    <div class="mx-auto max-w-6xl px-4 pt-8 sm:pt-12 xl:px-0">
      <h1 class="misha-heading max-w-3xl text-secondary">No es solo una carta.<br /><span class="text-primary">Es donde empieza el antojo.</span></h1>
      <p class="mt-6 max-w-xl text-sm leading-relaxed text-secondary/65 sm:text-base">Café peruano de alta calidad, métodos que invitan a quedarse y algo rico para acompañar el momento.</p>
    </div>
    <MenuHeaderSection />
    <MenuSection />
  </section>
</MainLayout>
